{
    "name": "gaby/php-ddd-base",
    "description": "Base PHP 7.4 + Slim 4 + DDD liviano (API, CMS y sitio)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^7.4",
        "lcobucci/jwt": "^4.1",
        "nyholm/psr7": "^1.5",
        "nyholm/psr7-server": "^1.0",
        "php-di/php-di": "^6.4",
        "ramsey/uuid": "^4.2",
        "robmorgan/phinx": "^0.14",
        "slim/slim": "^4"
    },
    "require-dev": {
        "pestphp/pest": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "Gaby\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gaby\\Tests\\": "src/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33",
            "ext-sodium": "1.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest"
    }
}
