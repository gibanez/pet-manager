# Ruta de la base SQLite (relativa a la raíz del proyecto o absoluta).
DB_PATH=storage/database.sqlite

# Secreto HMAC para firmar los JWT (64 hex recomendado).
JWT_SECRET=cambiame-por-un-secreto-de-64-hex

# Segundos de validez del token.
JWT_TTL=3600

# Zona horaria de la aplicación.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# true en desarrollo (muestra el detalle del error), false en producción.
APP_DEBUG=true
